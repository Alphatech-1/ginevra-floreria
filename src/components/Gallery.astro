        },
        {
          front: "/purple-rain.png",
          title: "PURPLE RAIN",
          price: "S/ 179.90",
          description: "Presentación premium en caja morada con 9 tulipanes morados y follaje. Elegancia y sofisticación en cada detalle.",
          composition: "9 tulipanes morados, follaje, caja morada premium, dedicatoria, guía de cuidados, alimento floral, aroma signature"
        },
        {
          front: "/mia.png",
          title: "MIA",
          price: "S/ 39.90",
          description: "Un Mini ramo con 3 rosas rosadas, crisantemos morados y silver. El detalle perfecto para un gesto especial.",
          composition: "3 rosas rosadas, crisantemos morados, silver, dedicatoria, bolsa Ginevra, guía de cuidados, alimento floral, aroma signature"
        },
        {
          front: "/box-hermosa.jpg",
          title: "BOX HERMOSA",
          price: "S/ 119.90",
          description: "Alegre combinación de 8 rosas lilas, margaritas y follaje. Un ramo que irradia alegría y frescura.",
          composition: "8 rosas lilas, margaritas, follaje, bolsa Ginevra, dedicatoria, guía de cuidados, parante, alimento floral, aroma signature"
        },

        {
          front: "/esperanza.png",
          title: "ESPERANZA",
          price: "S/ 89.90",
          description: "Voluminoso ramo de 5 girasoles, 4 claveles importados y 4 rosas. Una explosión de color y vitalidad.",
          composition: "5 girasoles, 4 claveles importados, 4 rosas, bolsa Ginevra, dedicatoria, guía de cuidados, alimento floral, aroma signature"
        },
        {
          front: "/rose.png",
          title: "ROSE",
          price: "S/ 84.90",
          description: "Delicado detalle en box circular con 5 rosas rosadas, crisantemos santini, 4 clavelones importados y follaje.",
          composition: "5 rosas rosadas, crisantemos santini, 4 clavelones importados, follaje, box circular, bolsa Ginevra, dedicatoria, guía de cuidados, alimento floral, aroma signature"
        },
        {
          front: "/mariposa.png",
          title: "MARIPOSA",
          price: "S/ 59.90",
          description: "Ramo hermoso compuesto de 6 rosas lilas y follaje. Simpleza y elegancia en un solo diseño.",
          composition: "6 rosas lilas, follaje, dedicatoria, bolsa Ginevra, guía de cuidados, alimento floral, aroma signature"
        },
        {
          front: "/dulzura.png",
          title: "DULZURA",
          price: "S/ 89.90",
          description: "Encantador arreglo compuesto de 7 rosas lilas, 3 clavelones rosados importados y follaje. Perfecto para expresar sentimientos sinceros.",
          composition: "7 rosas lilas, 3 clavelones rosados importados, follaje, bolsa Ginevra, dedicatoria, guía de cuidados, alimento floral, aroma signature"
        }
      ].map((item, index) => (
        <div class="group relative animate-fade-in-up" style={{ animationDelay: `${index * 0.1}s` }} data-index={index}>
          <!-- Contenedor de tarjeta flip -->
          <div class="relative h-[400px] lg:h-[450px] rounded-3xl overflow-hidden cursor-pointer perspective-1000 card-container">
            <!-- Cara frontal (imagen) -->
            <div class="absolute inset-0 w-full h-full backface-hidden transition-all duration-700 transform-style-3d card-front">
              <div class="relative w-full h-full">
                <img
                  src={item.front}
                  alt={`${item.title} - Ginevra Flores Día de la Mujer`}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-purple-900/90 via-transparent to-transparent"></div>
                
                <!-- Badge especial Día de la Mujer -->
                <div class="absolute top-4 left-4 z-20">
                  <div class="bg-purple-600/90 rounded-full px-3 py-1 shadow-lg backdrop-blur-sm">
                    <span class="text-xs font-bold text-white">🌸 Mujer</span>
                  </div>
                </div>
                
                <!-- Info en frontal con precio -->
                <div class="absolute bottom-0 left-0 right-0 p-6">
                  <h3 class="text-sm font-semibold text-white mb-2 truncate">{item.title}</h3>
                  <div class="flex items-center justify-between">
                    <div class="flex flex-col">
                      <span class="text-1xl font-bold text-white">
                        {item.price}
                      </span>
                    </div>
                    <div class="flex items-center gap-1">
                      <span class="text-white/70 text-sm">Click para detalles</span>
                      <i class="fas fa-info-circle text-white/70 ml-1"></i>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Cara trasera (descripción) con tonos morados -->
            <div class="absolute inset-0 w-full h-full backface-hidden transition-all duration-700 transform-style-3d rotate-y-180 bg-gradient-to-br from-purple-50 to-purple-100 card-back">
              <div class="relative w-full h-full p-6 flex flex-col justify-between">
                <!-- Botón para cerrar -->
                <button class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center text-purple-600 hover:scale-110 transition-transform duration-300 close-btn" aria-label="Cerrar detalles">
                  <i class="fas fa-times"></i>
                </button>
                
                {/* Información del producto */}
                <div class="overflow-y-auto pr-2 scrollable-content" style="max-height: 280px;">
                  <h3 class="font-serif text-xl font-bold text-purple-800 mb-3">{item.title}</h3>
                  <p class="text-purple-700/80 text-sm mb-4">
                    {item.description}
                  </p>
                  
                  {/* Composición */}
                  <div class="mb-4">
                    <h4 class="font-semibold text-purple-700 text-sm mb-2 flex items-center gap-2">
                      <i class="fas fa-leaf text-purple-500"></i>
                      Composición del ramo:
                    </h4>
                    <p class="text-purple-600/70 text-xs leading-relaxed bg-purple-100/50 p-3 rounded-lg border border-purple-200">
                      {item.composition}
                    </p>
                  </div>
                  
                  {/* Precio */}
                  <div class="flex items-center justify-between mb-4">
                    <span class="text-3xl font-bold text-purple-700">{item.price}</span>
                    <span class="text-sm bg-purple-200/50 px-3 py-1 rounded-full text-purple-700">
                      <i class="fas fa-check-circle mr-1"></i>
                      Disponible
                    </span>
                  </div>
                </div>

                {/* Botón de WhatsApp siempre visible */}
                <a
                  href={`${whatsappLink}?text=Hola Ginevra, para el Día de la Mujer me interesa: ${encodeURIComponent(item.title)} - Precio: ${encodeURIComponent(item.price)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/btn relative flex items-center justify-center gap-2 bg-gradient-to-r from-purple-500 to-purple-600 text-white px-6 py-4 rounded-xl font-semibold hover:shadow-xl hover:shadow-purple-500/25 transition-all duration-300 hover:scale-105 overflow-hidden w-full mt-4"
                >
                  <span class="relative z-10 flex items-center gap-2">
                    <i class="fab fa-whatsapp text-xl"></i>
                    Pedir por WhatsApp
                  </span>
                  <div class="absolute inset-0 bg-gradient-to-r from-purple-600 to-purple-700 opacity-0 group-hover/btn:opacity-100 transition-opacity duration-300"></div>
                  <span class="absolute right-4 group-hover/btn:translate-x-1 transition-transform duration-300">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                  </span>
                </a>
                
                {/* Texto de envío */}
                <p class="text-center text-xs text-purple-500/60 mt-3">
                  📍 Envío en Lima y Callao
                </p>
              </div>
            </div>
          </div>

          <!-- Indicador de hover (solo en desktop) -->
          <div class="absolute -top-3 -right-3 bg-purple-600 text-white rounded-full p-2 shadow-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 hidden lg:block">
            <i class="fas fa-info text-sm"></i>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA especial Día de la Mujer -->
    <div class="text-center mt-16 lg:mt-20 animate-fade-in-up" style="animation-delay: 0.7s">
      <div class="inline-flex flex-col sm:flex-row items-center gap-4 p-6 lg:p-8 bg-white/80 backdrop-blur-sm rounded-3xl border border-purple-200 shadow-lg">
        <div class="text-left">
          <h4 class="font-serif text-xl lg:text-2xl text-purple-800 mb-2">🌸 Celebra su día</h4>
          <p class="text-purple-600/80 mb-4">Hazle saber lo especial que es con nuestra colección exclusiva para ella.</p>
        </div>
        <a
          href={`${whatsappLink}?text=Hola Ginevra, quiero información sobre la colección del Día de la Mujer`}
          target="_blank"
          rel="noopener noreferrer"
          class="group/cta relative bg-gradient-to-r from-purple-500 to-purple-600 text-white px-8 py-4 rounded-full font-semibold hover:shadow-xl hover:shadow-purple-500/25 transition-all duration-300 hover:scale-105 whitespace-nowrap flex items-center gap-3"
        >
          <i class="fab fa-whatsapp text-xl"></i>
          <span class="relative z-10">Consultar colección</span>
          <div class="absolute inset-0 bg-gradient-to-r from-purple-600 to-purple-700 rounded-full opacity-0 group-hover/cta:opacity-100 transition-opacity duration-300"></div>
        </a>
      </div>
    </div>
  </div>
</section>


