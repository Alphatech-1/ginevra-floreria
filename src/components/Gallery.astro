        },

        {
          front: "/galeria-16.png",
          title: "ILYA",
          price: "S/ 79.90",
          description: "Una delicada composición floral dispuesta en una canasta de mimbre artesanal con asa. El diseño combina la elegancia de los lisianthus blancos con la textura rústica del statice en tonos malva.",
          composition: "Lisianthus, Claveles selectos, Follaje, Canasta de madera, Dedicatoria texturizada, Alimento para Flores"
        },
        {
          front: "/galeria-10.webp",
          title: "AMOR MIO",
          price: "S/ 74.90",
          description: "Una declaración de amor intensa y directa. Este ramo combina la pasión de las rosas rojas con la fuerza de los claveles, creando un mensaje floral que habla desde el corazón sin necesidad de palabras.",
