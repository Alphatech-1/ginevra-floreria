---
const whatsappLink = "https://wa.me/51932021142"; // CAMBIA ESTE LINK
---

<!-- Sección Día de la Mujer -->
<section id="dia-de-la-madre" class="relative overflow-hidden px-4 sm:px-6 lg:px-8 py-16 md:py-24 lg:py-32 bg-gradient-to-b from-pink-50 to-white">
  <!-- Elementos decorativos de fondo -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <div class="absolute -top-48 -right-48 w-96 h-96 bg-pink-200/30 rounded-full blur-3xl animate-pulse-slow"></div>
    <div class="absolute -bottom-48 -left-48 w-96 h-96 bg-rose-200/30 rounded-full blur-3xl animate-float-slow"></div>
    
    <!-- Corazones decorativos -->
    <div class="absolute top-20 left-10 opacity-[0.03]">
      <i class="fas fa-heart text-8xl text-pink-500"></i>
    </div>
    <div class="absolute bottom-20 right-10 opacity-[0.03]">
      <i class="fas fa-heart text-7xl text-rose-500"></i>
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto">
    <!-- Header con animación especial para Mamá -->
    <div class="text-center mb-16 lg:mb-20 animate-fade-in-up">
      <div class="inline-flex items-center gap-3 mb-4">
        <i class="fas fa-heart text-pink-500"></i>
        <span class="w-12 h-0.5 bg-gradient-to-r from-transparent to-pink-400"></span>
        <span class="text-pink-500 font-medium tracking-wider text-sm uppercase">Promoción Especial</span>
        <span class="w-12 h-0.5 bg-gradient-to-l from-transparent to-pink-400"></span>
        <i class="fas fa-heart text-pink-500"></i>
      </div>
      
      <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-pink-600 mb-6">
        <span class="block mb-2">💝 Día de la Madre</span>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-pink-500 to-rose-500">
          Flores para Mamá
        </span>
      </h2>
      
      <p class="text-secondary/80 text-lg max-w-2xl mx-auto leading-relaxed">
        Celebra a Mamá con nuestros arreglos exclusivos. ¡Aprovecha el 10% de descuento en preventa!
      </p>
      
      <!-- Banner de preventa -->
      <div class="inline-block mt-6 bg-gradient-to-r from-pink-500 to-rose-500 text-white px-6 py-3 rounded-full shadow-lg">
        <div class="flex items-center gap-3">
          <i class="fas fa-gift text-xl"></i>
          <span class="font-semibold">🎁 PROMO PREVENTA: 10% DE DESCUENTO 🎁</span>
          <i class="fas fa-calendar-alt text-xl"></i>
        </div>
      </div>
    </div>

    <!-- Galería de productos Día de la Madre -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {[
        {
          front: "/amor eterno.png",
          title: "Amor Eterno",
          price: "S/ 299.90",
          promoPrice: "S/ 269.91",
          description: "Un ramo majestuoso que expresa el amor infinito hacia mamá. La combinación de rosas rosadas y rojas crea un mensaje de ternura y pasión filial perfecto para este día especial.",
          composition: "10 Rosas Rosadas premium, 21 Rosas Rojas premium, Mini Rosa Rosada, Hortensias, Follaje verde selecto y dogos. Incluye dedicatoria y Guía de Cuidados."
        },
        {
          front: "/Amor inmenso.png",
          title: "Amor Inmenso",
          price: "S/ 225.00",
          promoPrice: "S/ 202.50",
          description: "Un diseño elegante centrado en tulipanes rojos que representan el amor eterno y la perfección. Ideal para demostrarle a mamá cuánto la amas.",
          composition: "9 Tulipanes Rojos, follaje verde. Incluye Bolsa Ginevra, Dedicatoria, Guía de Cuidados y Alimento Floral."
        },
        {
          front: "/Eternal.png",
          title: "Eternal",
          price: "S/ 144.90",
          promoPrice: "S/ 130.41",
          description: "La pasión en su máxima expresión. 19 rosas rojas que hablan de un amor que trasciende el tiempo, perfecto para celebrar a la mujer más importante de tu vida.",
          composition: "19 Rosas Rojas premium y follaje verde. Incluye Bolsa Ginevra, Dedicatoria, Guía de Cuidados, y Alimento Floral."
        },
        {
          front: "/dulcemama.png",
          title: "Dulce Mamá",
          price: "S/ 99.90",
          promoPrice: "S/ 89.91",
          description: "Un ramo dulce y encantador que lleva la calidez de 11 rosas rojas. Perfecto para expresar ese cariño tan especial que solo una madre puede inspirar.",
          composition: "11 Rosas Rojas premium y follaje verde. Incluye Bolsa Ginevra, Dedicatoria, Guía de Cuidados y Alimento Floral."
        },
        {
          front: "/corazonmama.png",
          title: "Corazón de Mamá",
          price: "S/ 129.90",
          promoPrice: "S/ 116.91",
          description: "Un diseño temático con rosas mandala y rojas que forma un corazón simbólico. Cada rosa representa un latido de amor hacia mamá.",
          composition: "12 Rosas Rosadas premium, 6 Rosas Rojas premium, Mini Rosa Rosada y follaje verde. Incluye Bolsa Ginevra, Dedicatoria, Guía de Cuidados y Alimento Floral."
        },
        {
          front: "/canastaBonita.png",
          title: "Canasta Bonita",
          price: "S/ 89.90",
          promoPrice: "S/ 80.91",
          description: "Un arreglo rústico y colorido que trae la frescura del campo a casa de mamá. Perfecto para las madres que aman la naturaleza y los detalles auténticos.",
          composition: "8 Rosas Rosadas, Astromelias y follaje verde. Incluye Bolsa Ginevra, Dedicatoria, Guía de Cuidados y Alimento Floral."
        },
        {
          front: "/BoxGinevra.png",
          title: "Box Ginevra",
          price: "S/ 239.00",
          promoPrice: "S/ 215.10",
          description: "Un regalo espectacular en un elegante box circular rojo. 30 rosas rojas que envuelven a mamá en un mar de amor y elegancia.",
          composition: "30 Rosas Rojas premium y follaje verde selecto. Incluye Box circular Rojo, Bolsa Ginevra, Dedicatoria, Guía de Cuidados, y Alimento Floral."
        },
        {
          front: "/boxEncanto.png",
          title: "Box Encanta de Mamá",
          price: "S/ 239.00",
          promoPrice: "S/ 215.10",
          description: "La delicadeza en su máxima expresión. Un box circular rosado con 30 rosas que capturan la ternura y dulzura del amor maternal.",
          composition: "30 Rosas Rosadas premium y follaje verde selecto. Incluye Box circular Rosado, Bolsa Ginevra, Dedicatoria, Guía de Cuidados, y Alimento Floral."
        },
        {
          front: "/jardin.png",
          title: "Jardín de Amor",
          price: "S/ 69.90",
          promoPrice: "S/ 62.90",
          description: "Un pequeño jardín que cabe en la palma de la mano pero tiene el corazón más grande. Perfecto para un detalle sorpresa que emocionará a mamá.",
          composition: "Flores selectas variadas en una presentación especial. Incluye Bolsa Ginevra, Dedicatoria y Guía de Cuidados."
        }
      ].map((item, index) => (
        <div class="group relative animate-fade-in-up" style={{ animationDelay: `${index * 0.1}s` }} data-index={index}>
          <!-- Contenedor de tarjeta -->
          <div class="relative h-[450px] lg:h-[500px] rounded-3xl overflow-hidden cursor-pointer perspective-1000 card-container">
            <!-- Cara frontal (imagen) -->
            <div class="absolute inset-0 w-full h-full backface-hidden transition-all duration-700 transform-style-3d card-front">
              <div class="relative w-full h-full">
                <img
                  src={item.front}
                  alt={`${item.title} - Día de la Madre Ginevra`}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
                
                <!-- Badge de preventa -->
                <div class="absolute top-4 left-4 z-20">
                  <div class="bg-gradient-to-r from-pink-500 to-rose-500 text-white rounded-full px-3 py-1.5 shadow-lg">
                    <span class="text-xs font-bold whitespace-nowrap">🎁 10% OFF</span>
                  </div>
                </div>
                
                <!-- Badge de recomendado -->
                {index < 3 && (
                  <div class="absolute top-4 right-4 z-20 bg-yellow-400 text-yellow-900 rounded-full px-3 py-1.5 shadow-lg">
                    <span class="text-xs font-bold whitespace-nowrap">⭐ Más Vendido</span>
                  </div>
                )}
                
                <!-- Info en frontal -->
                <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-6 bg-gradient-to-t from-black/80 via-black/30 to-transparent">
                  <h3 class="text-lg sm:text-xl font-semibold text-white mb-1 truncate">{item.title}</h3>
                  <div class="flex items-center justify-between">
                    <div>
                      <span class="text-base sm:text-lg text-white/60 line-through mr-2">{item.price}</span>
                      <span class="text-xl sm:text-2xl font-bold text-pink-400">{item.promoPrice}</span>
                    </div>
                    <div class="flex items-center gap-1 bg-black/40 backdrop-blur-sm rounded-full px-2 sm:px-3 py-1">
                      <span class="text-white text-xs sm:text-sm font-medium">Ver detalles</span>
                      <i class="fas fa-info-circle text-white ml-1 text-xs sm:text-sm"></i>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Cara trasera (descripción) -->
            <div class="absolute inset-0 w-full h-full backface-hidden transition-all duration-700 transform-style-3d rotate-y-180 bg-gradient-to-br from-pink-50 to-rose-50 card-back">
              <div class="relative w-full h-full p-6 flex flex-col justify-between">
                <!-- Botón para cerrar -->
                <button class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center text-pink-500 hover:scale-110 transition-transform duration-300 close-btn" aria-label="Cerrar detalles">
                  <i class="fas fa-times"></i>
                </button>
                
                {/* Información del producto */}
                <div class="overflow-y-auto pr-2" style="max-height: 280px;">
                  <h3 class="font-serif text-xl font-bold text-pink-600 mb-3">{item.title}</h3>
                  <p class="text-secondary/80 text-sm mb-4 leading-relaxed">
                    {item.description}
                  </p>
                  
                  {/* Composición */}
                  <div class="mb-4">
                    <h4 class="font-semibold text-pink-600 text-sm mb-2 flex items-center gap-2">
                      <i class="fas fa-leaf text-pink-400"></i>
                      Composición del ramo:
                    </h4>
                    <p class="text-secondary/70 text-xs leading-relaxed bg-pink-50 p-3 rounded-lg">
                      {item.composition}
                    </p>
                  </div>
                  
                  <div class="flex items-center justify-between mb-4">
                    <div>
                      <span class="text-base text-secondary/60 line-through mr-2">Regular: {item.price}</span>
                      <span class="text-xl font-bold text-pink-600">Preventa: {item.promoPrice}</span>
                    </div>

                  </div>
                </div>

                {/* Botón de WhatsApp */}
                <a
                  href={`${whatsappLink}?text=Hola Ginevra, estoy interesado en el arreglo "${item.title}" para el Día de la Madre (precio preventa: ${item.promoPrice})`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/btn relative flex items-center justify-center gap-2 bg-gradient-to-r from-green-500 to-green-600 text-white px-6 py-4 rounded-xl font-semibold hover:shadow-xl hover:shadow-green-500/25 transition-all duration-300 hover:scale-105 overflow-hidden w-full mt-4"
                >
                  <span class="relative z-10 flex items-center gap-2">
                    <i class="fab fa-whatsapp text-xl"></i>
                    Reservar por WhatsApp
                  </span>
                  <div class="absolute inset-0 bg-gradient-to-r from-green-600 to-green-700 opacity-0 group-hover/btn:opacity-100 transition-opacity duration-300"></div>
                  <span class="absolute right-4 group-hover/btn:translate-x-1 transition-transform duration-300">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                  </span>
                </a>
                
                {/* Texto de preventa */}
                <p class="text-center text-xs text-pink-500 font-semibold mt-3">
                  ⏰ Promoción válida por tiempo limitado
                </p>
              </div>
            </div>
          </div>

          <!-- Indicador de hover -->
          <div class="absolute -top-3 -right-3 bg-pink-500 text-white rounded-full p-2 shadow-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 hidden lg:block">
            <i class="fas fa-heart text-sm"></i>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA final Día de la Madre -->
    <div class="text-center mt-16 lg:mt-20 animate-fade-in-up" style="animation-delay: 0.7s">
      <div class="inline-flex flex-col sm:flex-row items-center gap-4 p-6 lg:p-8 bg-gradient-to-r from-pink-50 to-rose-50 rounded-3xl border border-pink-200 shadow-lg">
        <div class="text-left">
          <h4 class="font-serif text-xl lg:text-2xl text-pink-600 mb-2">🎀 ¿Quieres sorprender a Mamá?</h4>
          <p class="text-secondary/80 mb-4">Haz tu pedido ahora y asegura el 10% de descuento en preventa.</p>
        </div>
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="group/cta relative bg-gradient-to-r from-pink-500 to-rose-500 text-white px-8 py-4 rounded-full font-semibold hover:shadow-xl hover:shadow-pink-500/25 transition-all duration-300 hover:scale-105 whitespace-nowrap flex items-center gap-3"
        >
          <i class="fas fa-heart text-xl"></i>
          <span class="relative z-10">Reservar para Mamá</span>
          <div class="absolute inset-0 bg-gradient-to-r from-rose-500 to-pink-500 rounded-full opacity-0 group-hover/cta:opacity-100 transition-opacity duration-300"></div>
        </a>
      </div>
    </div>
  </div>
</section>


<section id="catalogo" class="relative overflow-hidden px-4 sm:px-6 lg:px-8 py-16 md:py-24 lg:py-32 bg-gradient-to-b from-white to-primary/5">
  <!-- Elementos decorativos de fondo -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <div class="absolute -top-48 -right-48 w-96 h-96 bg-primary/5 rounded-full blur-3xl animate-pulse-slow"></div>
    <div class="absolute -bottom-48 -left-48 w-96 h-96 bg-secondary/5 rounded-full blur-3xl animate-float-slow"></div>
    
    <!-- Patrones florales decorativos -->
    <div class="absolute top-1/4 left-10 opacity-[0.03] rotate-12">
      <svg class="w-32 h-32 text-primary" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12,2L15.09,8.26L22,9.27L17,14.14L18.18,21.02L12,17.77L5.82,21.02L7,14.14L2,9.27L8.91,8.26L12,2Z"/>
      </svg>
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto">
    <!-- Header con animación -->
    <div class="text-center mb-16 lg:mb-20 animate-fade-in-up">
      <div class="inline-flex items-center gap-3 mb-4">
        <span class="w-12 h-0.5 bg-gradient-to-r from-transparent to-primary"></span>
        <span class="text-primary font-medium tracking-wider text-sm uppercase">Colección</span>
        <span class="w-12 h-0.5 bg-gradient-to-l from-transparent to-primary"></span>
      </div>
      
      <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-primary mb-6">
        <span class="block mb-2">Nuestro catálogo</span>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">
          Lo de siempre
        </span>
      </h2>
      
      <p class="text-secondary/80 text-lg max-w-2xl mx-auto leading-relaxed">
        Descubre nuestras creaciones más destacadas de todos los tiempos  .
      </p>
    </div>

    <!-- Galería de productos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {[
        {
          front: "/galeria-2.webp",
          title: "ESPIRAL DE MARGARITAS",
          price: "S/ 189.90",
          description: "La combinación perfecta entre la intensidad del amor y la sencillez de la alegría. Este diseño captura la esencia de un jardín, donde las rosas rojas y rosadas comparten protagonismo con la frescura de las margaritas y la intensidad de la hortencia.",
          composition: "8 Rosas Rojas premium, 8 Rosas Rosadas premium, Margaritas, Follaje (lluvia), Base cilindrica, Dedicatoria"
        },

        {
          front: "/galeria-12.png",
          title: "CARMESI",
          price: "S/ 79.90",
          description: "Un tributo a la calidez y los lazos eternos. Esta cesta combina la resistencia y belleza de los claveles con la delicadeza de las Mini rosas, creando un jardín portátil lleno de pasión.",
          composition: "Mini rosas selectas rojas, Claveles, Follaje, Dedicatoria Texturizada, Alimento para Flores, Canasta de Madera"
        },

        {
          front: "/galeria-9.webp",
          title: "DELIRIO DE AMOR",
          price: "S/ 99.90",
          description: "Un arreglo estilizado que combina la majestuosidad de los lirios en tonos rosado claro y matices fucsia con la suavidad de los lisianthus blancos y toques de claveles rosados. La presencia de capullos cerrados asegura una belleza duradera.",
