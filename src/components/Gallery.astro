<!-- Sección Día de la Mujer -->
<section id="dia-de-la-mujer" class="relative overflow-hidden px-4 sm:px-6 lg:px-8 py-16 md:py-24 lg:py-32 bg-gradient-to-b from-purple-50 to-purple-100/30">
  <!-- Elementos decorativos de fondo en tonos morados -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <div class="absolute -top-48 -right-48 w-96 h-96 bg-purple-300/20 rounded-full blur-3xl animate-pulse-slow"></div>
    <div class="absolute -bottom-48 -left-48 w-96 h-96 bg-purple-400/20 rounded-full blur-3xl animate-float-slow"></div>
    
    <!-- Patrones florales decorativos en morado -->
    <div class="absolute top-1/4 right-10 opacity-[0.03] rotate-12">
      <svg class="w-32 h-32 text-purple-600" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12,2L15.09,8.26L22,9.27L17,14.14L18.18,21.02L12,17.77L5.82,21.02L7,14.14L2,9.27L8.91,8.26L12,2Z"/>
      </svg>
    </div>
    <!-- Flores decorativas adicionales -->
    <div class="absolute bottom-1/4 left-10 opacity-[0.02]">
      <svg class="w-24 h-24 text-purple-600" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12,2C13,4 15,6 18,7C15,8 13,10 12,12C11,10 9,8 6,7C9,6 11,4 12,2M12,14C14,14 17,15 19,16C16,17 14,19 12,21C10,19 8,17 5,16C7,15 10,14 12,14M12,13C10,13 8,12 6,11C8,10 10,8 12,6C14,8 16,10 18,11C16,12 14,13 12,13Z"/>
      </svg>
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto">
    <!-- Header con animación - estilo morado -->
    <div class="text-center mb-16 lg:mb-20 animate-fade-in-up">
      <div class="inline-flex items-center gap-3 mb-4">
        <span class="w-12 h-0.5 bg-gradient-to-r from-transparent to-purple-600"></span>
        <span class="text-purple-600 font-medium tracking-wider text-sm uppercase">Edición Especial</span>
        <span class="w-12 h-0.5 bg-gradient-to-l from-transparent to-purple-600"></span>
      </div>
      
      <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-purple-800 mb-6">
        <span class="block mb-2">🌸 Día de la Mujer</span>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-purple-400">
          Colección exclusiva
        </span>
      </h2>
      
      <p class="text-purple-700/70 text-lg max-w-2xl mx-auto leading-relaxed">
        Celebra su esencia con nuestra selección especial en tonos lila y morado, creada para honrar a quien ilumina tus días.
      </p>
    </div>

    <!-- Galería de productos Día de la Mujer -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {[
        {
          front: "/canasta-bonita.jpeg",
          title: "CANASTA BONITA",
          price: "S/ 79.90",
          description: "Arreglo en canasta circular con 6 rosas fucsias, astromelias rosadas y follaje. Una combinación delicada y encantadora para celebrar su día.",
          composition: "6 rosas fucsias, astromelias rosadas, follaje, bolsa Ginevra, dedicatoria, guía de cuidados, parante, alimento floral, aroma signature"
        },
        {
          front: "/empoderate.png",
          title: "EMPODERATE",
          price: "S/ 129.90",
          description: "Elegante ramo compuesto por 15 rosas lilas y 6 claveles rosados, acentuado con silver. Una pieza que transmite fuerza y delicadeza.",
