        },

        {
          front: "/galeria-3.webp",
          title: "ELAIA",
          price: "S/ 179.90",
          description: "Un romance que trasciende el tiempo. 'Eternidad' combina la pureza de las hortensias con la promesa de los tulipanes en un abrazo de pétalos y fragancia. Diseñado para quienes creen en los lazos que nunca se marchitan.",
          composition: "5 Tulipanes Selectos, Mini Rosas Rosadas, 1 Hortensia, Dedicatoria Texturizada, Alimento para Flores"
